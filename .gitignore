# Local Pi runtime state
.atl/

# Secrets — DB credentials, WordPress salts, Cloudflare tunnel token.
# wp-config.php is GENERATED by reset-rebuild.sh and embeds random salts.
.env
wp-config.php

# Build artifact: rebuilt by ./build-zip.sh from webp-studio/.
webp-studio.zip

# Staging database analysis environment.
#
# analysis/ holds the compose file and the query helpers, which are safe to keep.
# analysis/.env holds the STAGING DATABASE PASSWORD and must never be committed.
analysis/.env

# Scratch files from earlier debugging sessions (unreferenced by any config).
temp_method.php
temp_stats.php
large.png
test.jpg
test.png
valid.png
docker-compose.yml.backup

# Browser-automation artifacts from the Playwright MCP session.
.playwright-mcp/

# Seed images.
#
# These are deliberately NOT ignored. They are fixtures the development environment
# depends on: reset-rebuild.sh destroys the WordPress volume and re-imports them, so a
# fresh clone can boot with a real media library instead of an empty one.
#
# If you would rather not carry ~1.8 MB of binaries in the history, delete this comment
# and add the line instead; seed-images/README.md explains how to regenerate them with
# `seed-images/seed.sh --download`, and the download uses fixed Lorem Picsum IDs so the
# result is reproducible.